// Template for secrets.h - copy this file to secrets.h and fill in your own
// values. secrets.h itself is gitignored and never committed; this .example
// file is the only one that should be checked into the repo.
//
//   cp secrets.h.example secrets.h
//
// then edit secrets.h with your real Wi-Fi credentials and Victron device
// keys (see README.md for where to find the Victron MAC/key values).
#pragma once

const char* WIFI_SSID     = "YOUR_WIFI_SSID";
const char* WIFI_PASSWORD = "YOUR_WIFI_PASSWORD";

// From VictronConnect -> Settings -> Product Info -> Instant Readout details
const char* SOLAR_MAC = "YOUR_SOLAR_CHARGER_MAC";   // e.g. "cd74d7bbdba5"
const char* SOLAR_KEY = "YOUR_SOLAR_CHARGER_KEY";   // 32 hex characters
const char* SHUNT_MAC = "YOUR_BATTERY_SHUNT_MAC";
const char* SHUNT_KEY = "YOUR_BATTERY_SHUNT_KEY";
